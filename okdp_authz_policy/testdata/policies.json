{
  "policies": {
    "authz": {
      "analysts-gold": {
        "metadata": {"namespace": "authz", "name": "analysts-gold"},
        "spec": {
          "subjects": {"groups": ["business_analyst"]},
          "resource": {"catalog": "authz-polaris", "warehouse": "gold", "namespace": "*", "table": "*"},
          "privileges": ["select"],
          "rowFilter": [{"column": "country", "op": "eq", "value": "FR"}],
          "columns": [{"name": "email", "action": "mask-alphanum"}]
        }
      },
      "engineers-silver": {
        "metadata": {"namespace": "authz", "name": "engineers-silver"},
        "spec": {
          "subjects": {"groups": ["data_engineer"]},
          "resource": {"catalog": "authz-polaris", "warehouse": "silver", "namespace": "*", "table": "*"},
          "privileges": ["select", "insert", "create"]
        }
      },
      "etl-silver": {
        "metadata": {"namespace": "authz", "name": "etl-silver"},
        "spec": {
          "subjects": {"clients": ["2e97ae93-a55f-41a9-908e-622628f66e73"]},
          "resource": {"catalog": "authz-polaris", "warehouse": "silver", "namespace": "*", "table": "*"},
          "privileges": ["select", "insert", "update", "delete", "create", "drop"]
        }
      },
      "hub-gold": {
        "metadata": {"namespace": "authz", "name": "hub-gold"},
        "spec": {
          "subjects": {"clients": ["43db057e-c761-40f8-aa8e-ada778b92910"]},
          "resource": {"catalog": "authz-polaris", "warehouse": "gold", "namespace": "sales", "table": "*"},
          "privileges": ["select"]
        }
      },
      "other-catalog": {
        "metadata": {"namespace": "authz", "name": "other-catalog"},
        "spec": {
          "subjects": {"groups": ["data_scientist"]},
          "resource": {"catalog": "other-polaris", "warehouse": "*", "namespace": "*", "table": "*"},
          "privileges": ["select"]
        }
      }
    },
    "fraud": {
      "foreign": {
        "metadata": {"namespace": "fraud", "name": "foreign"},
        "spec": {
          "subjects": {"groups": ["business_analyst"]},
          "resource": {"catalog": "authz-polaris", "warehouse": "*", "namespace": "*", "table": "*"},
          "privileges": ["select", "insert"]
        }
      }
    }
  }
}
